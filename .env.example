APP_NAME="Console WhatsApp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Libreville

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Meta WhatsApp Cloud API -------------------------------------------------
# Jeton d'accès de l'app Meta (System User de préférence : les jetons
# temporaires expirent au bout de 24 h).
WHATSAPP_TOKEN=
# Identifiant du compte WhatsApp Business.
WHATSAPP_WABA_ID=
# Identifiant du numéro émetteur (Phone number ID, pas le numéro lui-même).
WHATSAPP_PHONE_ID=
# Chaîne de votre choix, à recopier à l'identique dans la console Meta lors de
# l'abonnement au webhook : elle sert au handshake GET.
WHATSAPP_VERIFY_TOKEN=
# App Secret de l'app Meta : valide la signature X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com

# --- Accès à la console ------------------------------------------------------
# Compte unique de l'opérateur : ni table users, ni modèle User.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Bot ---------------------------------------------------------------------
BOT_ENABLED=true
# keyword | ai — bascule à chaud avec « php artisan bot:mode ai ».
BOT_MODE=keyword
# Requis uniquement en mode ai.
ANTHROPIC_API_KEY=

# --- Infra -------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=whatsapp
DB_USERNAME=whatsapp
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
# Aucune table de jobs : trois tables métier et rien d'autre. Les échecs
# partent dans les logs.
QUEUE_FAILED_DRIVER=null
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
BROADCAST_CONNECTION=reverb

# --- Reverb (temps réel) -----------------------------------------------------
REVERB_APP_ID=whatsapp-console
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Ce que le NAVIGATEUR doit contacter. Derrière un tunnel ou un domaine, ces
# valeurs doivent porter l'hôte public — elles sont figées dans les assets au
# moment du « npm run build », pas lues à l'exécution.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
